# Public Supabase connection values. Obtain local values with `npm run db:status`
# or production values from the approved Supabase project Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values used by the trusted n8n/Gmail ingestion boundary.
# Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SECRET_KEY=
EMAIL_INGESTION_TOKEN=
AUTOMATION_SHARED_SECRET=

# Server-only Phase 10 model configuration.
# `local` is the deterministic no-cost development provider.
# Set `openai` only after the production data policy and API project are approved.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
