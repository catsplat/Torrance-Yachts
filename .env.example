# Public Supabase connection values. Obtain local values with `npm run db:status`
# or production values from the approved Supabase project Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values used by trusted application adapters and automation.
# Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SECRET_KEY=
AUTOMATION_SHARED_SECRET=
MONITORING_SHARED_SECRET=
TELEGRAM_BOT_TOKEN=
# Used only to verify inbound Telegram webhook calls and generate the staff
# bot-pairing link. Register the webhook separately; never expose either value.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Company-owned Google OAuth application. These values are server-only: staff
# connect their own inbox through Google's consent screen and never see them.
# Register <APP_BASE_URL>/api/integrations/google/callback as the exact redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Enables the optional, familiar "Continue with Google" application sign-in UI.
# It must only be set to true after Supabase Auth's Google provider is configured
# with the separate server-only values below. Never put real values in this file.
GOOGLE_SIGN_IN_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
N8N_HEALTH_URL=
AUTH_SMTP_CONFIGURED=false
# When true, administrators generate single-use Supabase invitation/recovery
# links and deliver them through an approved secure channel; SMTP is optional.
AUTH_MANUAL_LINKS_ENABLED=false
# High-entropy, 32+ character bootstrap secret. Configure only for the first
# administrator creation at /setup, then remove it and restart the application.
INITIAL_ADMIN_SETUP_TOKEN=
# Must be the canonical browser origin for this environment. Configure the
# same origin's `/auth/confirm` URL in Supabase Auth redirect allow-lists.
APP_BASE_URL=
APP_ENVIRONMENT=development
DEPLOYMENT_VERSION=
# Enable only behind the approved private reverse proxy. Local development and
# direct deployments must not trust client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
MFA_ENFORCEMENT_ENABLED=true

# Server-only Phase 10 model configuration.
# `local` is the deterministic no-cost development provider. `ollama` uses a
# locally running Ollama model by default and keeps synthetic test data offline.
# Set `openai` only after the production data policy and API project are approved.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Leave empty for local Ollama. A future cloud token belongs only in ignored env files.
OLLAMA_API_KEY=

# Local ClamAV is started by `npm run automation:start` and only listens on
# loopback. Files stay in quarantine if it is unavailable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=12000
