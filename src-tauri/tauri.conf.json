{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torrance Yachts",
  "version": "0.19.1",
  "identifier": "com.torranceyachts.charteroperations",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Torrance Yachts",
        "displayLanguageSelector": false
      }
    }
  }
}
