# Runtime values only. Keep the actual file mode 600 and do not commit it.
APP_DOMAIN=
APP_ENVIRONMENT=production
HOSTED_PILOT_MODE=false
DEPLOYMENT_INGRESS=cloudflare
DEPLOYMENT_IMAGE_ENVIRONMENT=production
DEPLOYMENT_VERSION=
APP_IMAGE=
CLOUDFLARE_TUNNEL_TOKEN=

# Browser requests use the private HTTPS application hostname. Server-side
# requests use the internal Kong route set in docker-compose.yml.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Generated once on the VPS by ops/bootstrap-selfhosted-supabase.sh. These are
# kept in the same protected runtime file because the database, Auth and the
# application must agree on them.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

AUTOMATION_SHARED_SECRET=
MONITORING_SHARED_SECRET=
AUTH_SMTP_CONFIGURED=false
AUTH_MANUAL_LINKS_ENABLED=false
INITIAL_ADMIN_SETUP_TOKEN=

# Supabase Auth invitation, recovery and verification email delivery.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Torrance Yachts

# Web OAuth client for the application-owned Gmail/Workspace connection.
# The hosted callback is documented in docs/operations/GOOGLE_WORKSPACE_ACTIVATION.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SIGN_IN_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Encrypted backup configuration. Keep the age private identity outside this
# VPS; this host needs only the public recipient. Production also requires an
# rclone remote pointing at a separate client-owned failure domain.
BACKUP_DIRECTORY=/opt/torrance-yachts/backups
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_RCLONE_REMOTE=
