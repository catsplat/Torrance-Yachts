# Browser acceptance configuration. Copy to .env.e2e.local and keep it local.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_ADMIN_EMAIL=approved.internal.user@example.test
E2E_ADMIN_PASSWORD=<local-development-password>

# Set this only for a fresh disposable database with no existing profiles.
E2E_ALLOW_INITIAL_SETUP=false
INITIAL_ADMIN_SETUP_TOKEN=<generated-one-time-test-token>
