{
  "id": "TYGmailRead0001",
  "name": "Torrance Yachts - Gmail mark-read worker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "b93b1a2e-7a7a-4142-9b9e-100000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TORRANCE_APP_URL }}/api/integrations/deliveries/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AUTOMATION_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"workerId\":\"n8n-gmail-mark-read\",\"limit\":20,\"operations\":[\"gmail_mark_read\"]}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b93b1a2e-7a7a-4142-9b9e-100000000002",
      "name": "Claim mark-read actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "deliveries",
        "options": {}
      },
      "id": "b93b1a2e-7a7a-4142-9b9e-100000000003",
      "name": "One mark-read action",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $json.payload.provider_message_id }}"
      },
      "id": "b93b1a2e-7a7a-4142-9b9e-100000000004",
      "name": "Mark Gmail message read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [720, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TORRANCE_APP_URL }}/api/integrations/deliveries/{{ $('One mark-read action').item.json.id }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AUTOMATION_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"workerId\":\"n8n-gmail-mark-read\",\"externalId\":\"{{ $('One mark-read action').item.json.payload.provider_message_id }}\",\"externalUrl\":\"\"}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b93b1a2e-7a7a-4142-9b9e-100000000005",
      "name": "Record mark-read success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TORRANCE_APP_URL }}/api/integrations/deliveries/{{ $('One mark-read action').item.json.id }}/fail",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AUTOMATION_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { workerId: 'n8n-gmail-mark-read', errorCode: 'gmail_action_failed', errorMessage: String($json.error?.message ?? $json.error ?? 'Gmail mark-read failed').slice(0, 2000), retryable: true } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b93b1a2e-7a7a-4142-9b9e-100000000006",
      "name": "Record mark-read failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 120]
    }
  ],
  "connections": {
    "Every minute": { "main": [[{ "node": "Claim mark-read actions", "type": "main", "index": 0 }]] },
    "Claim mark-read actions": { "main": [[{ "node": "One mark-read action", "type": "main", "index": 0 }]] },
    "One mark-read action": { "main": [[{ "node": "Mark Gmail message read", "type": "main", "index": 0 }]] },
    "Mark Gmail message read": {
      "main": [
        [{ "node": "Record mark-read success", "type": "main", "index": 0 }],
        [{ "node": "Record mark-read failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Europe/London" },
  "versionId": "b93b1a2e-7a7a-4142-9b9e-100000000007",
  "meta": { "templateCredsSetupCompleted": false },
  "tags": []
}
